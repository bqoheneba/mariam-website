# Static Next.js export on Apache — keep JS/CSS/fonts/images off the SPA fallback.
# Upload the full `out/` folder (including `_next/` and `images/`).

DirectoryIndex index.html

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Subfolder deploy: uncomment and set (must end with /)
  # RewriteBase /your-subfolder/

  # Never rewrite Next bundles, payload files, or common static assets
  RewriteRule ^_next/ - [L]
  RewriteRule ^_not-found - [L]
  RewriteRule ^__next - [L]
  RewriteRule ^images/ - [L]
  RewriteRule ^favicon\.ico$ - [L]
  RewriteRule \.(?:js|mjs|css|woff2?|ico|png|jpe?g|gif|webp|svg|map|txt|json)$ - [L]

  # Real files or directories only
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Client-only paths → app shell
  RewriteRule ^ index.html [L]
</IfModule>
